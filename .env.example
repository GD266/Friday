# Friday — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# --- General ---
FRIDAY_ENV=development
# Options: development | production | test
FRIDAY_LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8000

# --- AI Providers ---
# Choose default provider; provider-specific keys are only required when that provider is used.
FRIDAY_PROVIDER=mock
# Options: mock | openai | anthropic | openrouter | ollama | gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Memory ---
FRIDAY_MEMORY_PATH=./data/memory.json
FRIDAY_MEMORY_BACKEND=json
# Options: json | sqlite (future) | vector (future)

# --- Voice (stub — not implemented yet) ---
FRIDAY_VOICE_ENABLED=false
FRIDAY_STT_PROVIDER=whisper
FRIDAY_TTS_PROVIDER=elevenlabs

# --- Computer Control (stub — not implemented yet) ---
FRIDAY_COMPUTER_CONTROL_ENABLED=false
FRIDAY_COMPUTER_CONTROL_SANDBOX=true

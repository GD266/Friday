# FRIDAY provider configuration (Phase 2) — copy to `.env` for local use.
# NEVER commit a real `.env` file. Secrets stay out of source and bundles:
# the desktop backend reads FRIDAY_API_KEY from process environment.

# Required for real AI replies (any OpenAI-compatible endpoint):
FRIDAY_API_KEY=

# Optional overrides:
FRIDAY_API_BASE=https://api.openai.com/v1
FRIDAY_MODEL=gpt-4o-mini
FRIDAY_TIMEOUT_SECS=90

# DEV-ONLY browser fallback for plain `npm run dev` (no desktop shell).
# Ignored in production builds. Prefer the desktop app + FRIDAY_API_KEY.
# VITE_FRIDAY_API_KEY=
# VITE_FRIDAY_API_BASE=https://api.openai.com/v1
# VITE_FRIDAY_MODEL=gpt-4o-mini
